+void
+togglenmaster(const Arg *arg)
+{
+	Client *c, *sel;
+
+	if (!selmon)
+		return;
+
+	if (selmon->nmaster > 1) {
+		selmon->nmaster = 1;
+		arrange(selmon);
+		return;
+	}
+
+	/* Going from one master to two: make sure the focused client ends up
+	 * in the master area instead of whichever client happened to be next
+	 * in the tiling order. */
+	sel = focustop(selmon);
+	if (sel && !sel->isfloating) {
+		wl_list_for_each(c, &clients, link) {
+			if (VISIBLEON(c, selmon) && !c->isfloating)
+				break;
+		}
+		if (&c->link != &clients && c != sel) {
+			wl_list_remove(&sel->link);
+			wl_list_insert(&clients, &sel->link);
+		}
+	}
+
+	selmon->nmaster = 2;
+	arrange(selmon);
+}
