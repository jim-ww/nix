 void
+destroytouchpad(struct wl_listener *listener, void *data)
+{
+	Touchpad *t = wl_container_of(listener, t, destroy);
+	wl_list_remove(&t->destroy.link);
+	wl_list_remove(&t->link);
+	free(t);
+}
+
+void
+toggletouchpad(const Arg *arg)
+{
+	Touchpad *t;
+
+	touchpaddisabled = !touchpaddisabled;
+	wl_list_for_each(t, &touchpads, link) {
+		if (!libinput_device_config_send_events_get_modes(t->device))
+			continue;
+		libinput_device_config_send_events_set_mode(t->device, touchpaddisabled
+				? LIBINPUT_CONFIG_SEND_EVENTS_DISABLED : send_events_mode);
+	}
+}
