+		if (!wlr_subsurface_try_from_wlr_surface(xdg_surface->surface)) {
+			if (blur) {
+				int blur_optimized = !c->isfloating || blur_xray;
+				wlr_scene_buffer_set_backdrop_blur_optimized(buffer, blur_optimized);
+			}
+		}
+	}
+}
