 void
+dwindle(Monitor *m)
+{
+	unsigned int i, n = 0;
+	int nx, ny, nw, nh, g;
+	int horizontal;
+	Client *c;
+
+	/* count clients */
+	wl_list_for_each(c, &clients, link)
+		if (VISIBLEON(c, m) && !c->isfloating && !c->isfullscreen)
+			n++;
+
+	if (n == 0)
+		return;
+
+	g = smartgaps && n == 1 ? 0 : (int)gappx;
+
+	nx = m->w.x + g;
+	ny = m->w.y + g;
+	nw = m->w.width - 2 * g;
+	nh = m->w.height - 2 * g;
+
+	horizontal = 1; // toggle split direction
+	i = 0;
+
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+			continue;
+
+		c->bw = smartborders && n == 1 ? 0 : borderpx;
+
+		if (i == n - 1) {
+			/* last window gets remaining space */
+			resize(c, (struct wlr_box){nx, ny, nw, nh}, 0);
+		} else if (horizontal) {
+			int w = (nw - g) / 2;
+
+			resize(c, (struct wlr_box){nx, ny, w, nh}, 0);
+
+			nx += w + g;
+			nw -= w + g;
+		} else {
+			int h = (nh - g) / 2;
+
+			resize(c, (struct wlr_box){nx, ny, nw, h}, 0);
+
+			ny += h + g;
+			nh -= h + g;
+		}
+
+		horizontal = !horizontal;
+		i++;
+	}
+}
